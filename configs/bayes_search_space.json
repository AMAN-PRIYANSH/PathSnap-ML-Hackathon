{
  "model": "HistGradientBoosting",
  "sampler": "TPE (Optuna), seed 42",
  "objective": "maximise mean observation-level Top-1 accuracy, 3-fold GroupKFold by trip, train partition only",
  "n_trials": 25,
  "max_points_per_trip": 800,
  "search_space": {
    "learning_rate":     {"type": "float", "low": 0.01, "high": 0.3, "log": true},
    "max_iter":          {"type": "int",   "low": 100,  "high": 600, "step": 50},
    "max_leaf_nodes":    {"type": "int",   "low": 15,   "high": 127},
    "min_samples_leaf":  {"type": "int",   "low": 10,   "high": 300, "log": true},
    "l2_regularization": {"type": "float", "low": 0.0,  "high": 10.0}
  },
  "untuned_defaults": {"max_iter": 300, "learning_rate": 0.1, "max_leaf_nodes": 31, "min_samples_leaf": 20, "l2_regularization": 0.0}
}
